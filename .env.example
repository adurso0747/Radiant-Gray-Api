# Postgres connection string (Neon → your project → Connection string).
# A plain "postgresql://" string works as-is — see
# Settings.normalize_database_url in app/config.py.
DATABASE_URL=postgresql://user:password@host/dbname

# Any long random string — sent as the X-API-Key header to read
# submissions via GET /api/submissions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Where new-submission notification emails get sent.
NOTIFY_EMAIL=you@example.com

# Resend API key (resend.com → API Keys). Leave blank to skip sending
# notification emails — submissions still get stored either way.
RESEND_API_KEY=

# Must be a verified sender/domain in Resend, or their shared
# onboarding@resend.dev address works for testing without domain setup.
FROM_EMAIL=onboarding@resend.dev

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,https://radiantgrayband.com

# slowapi rate-limit string, e.g. "5/hour" or "10/minute".
RATE_LIMIT=5/hour
